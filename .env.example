# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=wacc
POSTGRES_PASSWORD=wacc
POSTGRES_DB=wacc
# Host port for PostgreSQL (change if 5432 is taken).
POSTGRES_PORT=5432
# Host-side URL (pnpm dev on your machine). Docker Compose overrides the host with `postgres`.
DATABASE_URL=postgresql://wacc:wacc@localhost:5432/wacc?schema=public

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=3000
# Public base URL of the API. Meta must reach `${API_PUBLIC_URL}/webhooks/meta` over HTTPS in production.
API_PUBLIC_URL=http://localhost:3000
# Origin of the web app (CORS + CSRF origin check).
WEB_URL=http://localhost:5173
# Path under which the browser reaches the API through the web origin (Vite proxy / reverse proxy).
BROWSER_API_BASE_PATH=/api
# Set to true behind a reverse proxy so client IPs and rate limits are correct.
TRUST_PROXY=false

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
# Self-service sign up. The first account can always be created.
AUTH_ALLOW_SIGNUP=true

# ─── Secrets at rest ────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored Meta token unreadable.
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_KEY_ID=k1

# ─── Meta Graph API ─────────────────────────────────────────────────────────
# Latest version as of 2026-10: v26.0 (https://developers.facebook.com/docs/graph-api/changelog)
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_TIMEOUT_MS=20000
META_GRAPH_MAX_RETRIES=3

# Platform Meta app: needed for Embedded Signup and for the /webhooks/meta endpoint.
# Leave empty to use only the advanced (manual) connection, where each connection brings its own app.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID (WhatsApp Embedded Signup).
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Any random string; paste the same value in the Meta App dashboard → WhatsApp → Configuration.
META_WEBHOOK_VERIFY_TOKEN=

# Persist sanitized request/response bodies in Developer → API Logs.
API_LOG_BODIES=true

# ─── Web ────────────────────────────────────────────────────────────────────
WEB_PORT=5173
# Where the Vite dev server proxies /api (inside Docker: http://api:3000).
VITE_API_PROXY_TARGET=http://localhost:3000
